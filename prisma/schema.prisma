generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  FREELANCER
  UMKM
  ADMIN
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SubmissionStatus {
  PENDING_REVIEW
  REVISION_REQUESTED
  APPROVED
}

enum EscrowStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
}

// ==========================================
// USER & PROFILE MODELS
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(FREELANCER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile            Profile?
  resumes            ResumeATS[]
  userSkills         UserSkill[]
  jobsPosted         Job[]               @relation("EmployerJobs")
  proposalsSubmitted Proposal[]          @relation("FreelancerProposals")
  submissions        JobSubmission[]     @relation("FreelancerSubmissions")
  escrowAsEmployer   EscrowTransaction[] @relation("EmployerEscrow")
  escrowAsFreelancer EscrowTransaction[] @relation("FreelancerEscrow")
  reviewsGiven       Review[]            @relation("Reviewer")
  reviewsReceived    Review[]            @relation("Reviewee")
  notifications      Notification[]

  @@map("users")
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber  String?
  avatarUrl    String?
  bio          String?  @db.Text
  companyName  String?
  portfolioUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

model ResumeATS {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl          String
  atsScore         Int
  feedbackAnalysis Json?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("resumes_ats")
}

// ==========================================
// SKILL & MATCHING MODELS
// ==========================================

model Skill {
  id   String @id @default(uuid())
  name String @unique

  userSkills UserSkill[]
  jobSkills  JobSkill[]

  @@map("skills")
}

model UserSkill {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skills")
}

// ==========================================
// JOB & PROPOSAL MODELS
// ==========================================

model Job {
  id          String    @id @default(uuid())
  employerId  String
  employer    User      @relation("EmployerJobs", fields: [employerId], references: [id], onDelete: Cascade)
  title       String
  description String    @db.Text
  category    String
  budget      Float
  status      JobStatus @default(OPEN)
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  jobSkills   JobSkill[]
  proposals   Proposal[]
  submissions JobSubmission[]
  escrow      EscrowTransaction?
  review      Review?

  @@index([employerId])
  @@index([status])
  @@map("jobs")
}

model JobSkill {
  id      String @id @default(uuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@map("job_skills")
}

model Proposal {
  id            String         @id @default(uuid())
  jobId         String
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId  String
  freelancer    User           @relation("FreelancerProposals", fields: [freelancerId], references: [id], onDelete: Cascade)
  coverLetter   String?        @db.Text
  bidAmount     Float
  estimatedDays Int
  status        ProposalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([jobId])
  @@index([freelancerId])
  @@map("proposals")
}

// ==========================================
// SUBMISSION & WORK DELIVERABLES
// ==========================================

model JobSubmission {
  id            String           @id @default(uuid())
  jobId         String
  job           Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId  String
  freelancer    User             @relation("FreelancerSubmissions", fields: [freelancerId], references: [id], onDelete: Cascade)
  submissionUrl String
  notes         String?          @db.Text
  status        SubmissionStatus @default(PENDING_REVIEW)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([jobId])
  @@index([freelancerId])
  @@map("job_submissions")
}

// ==========================================
// PAYMENT & ESCROW TRANSACTIONS
// ==========================================

model EscrowTransaction {
  id                String       @id @default(uuid())
  jobId             String       @unique
  job               Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employerId        String
  employer          User         @relation("EmployerEscrow", fields: [employerId], references: [id])
  freelancerId      String?
  freelancer        User?        @relation("FreelancerEscrow", fields: [freelancerId], references: [id])
  amount            Float
  midtransSnapToken String?
  paymentStatus     EscrowStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([employerId])
  @@index([freelancerId])
  @@map("escrow_transactions")
}

// ==========================================
// REVIEW & NOTIFICATIONS
// ==========================================

model Review {
  id         String   @id @default(uuid())
  jobId      String   @unique
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}