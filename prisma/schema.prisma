generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model escrow_transactions {
  id                                            String       @id @default(uuid())
  jobId                                         String       @unique
  proposalId                                    String?      @unique
  employerId                                    String
  freelancerId                                  String?
  amount                                        Decimal      @db.Decimal(15, 2)
  midtransOrderId                               String?      @unique
  midtransSnapToken                             String?
  paymentStatus                                 EscrowStatus @default(PENDING)
  paidAt                                        DateTime?
  releasedAt                                    DateTime?
  createdAt                                     DateTime     @default(now())
  updatedAt                                     DateTime     @updatedAt
  users_escrow_transactions_employerIdTousers   users        @relation("escrow_transactions_employerIdTousers", fields: [employerId], references: [id])
  users_escrow_transactions_freelancerIdTousers users?       @relation("escrow_transactions_freelancerIdTousers", fields: [freelancerId], references: [id])
  jobs                                          jobs         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposals                                     proposals?   @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([employerId])
  @@index([freelancerId])
}

model job_skills {
  id      String @id @default(uuid())
  jobId   String
  skillId String
  jobs    jobs   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skills  skills @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model job_submissions {
  id            String           @id @default(uuid())
  jobId         String
  freelancerId  String
  submissionUrl String
  notes         String?
  revisionNote  String?
  status        SubmissionStatus @default(PENDING_REVIEW)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  users         users            @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  jobs          jobs             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([freelancerId])
  @@index([jobId])
}

model jobs {
  id                  String               @id @default(uuid())
  employerId          String
  title               String
  description         String
  category            String
  budget              Decimal              @db.Decimal(15, 2)
  estimatedHours      Int                  @default(1)
  status              JobStatus            @default(OPEN)
  deadline            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  escrow_transactions escrow_transactions?
  job_skills          job_skills[]
  job_submissions     job_submissions[]
  users               users                @relation(fields: [employerId], references: [id], onDelete: Cascade)
  proposals           proposals[]
  reviews             reviews?
  chat_rooms          chat_rooms[]

  @@index([employerId])
  @@index([status])
}

model notifications {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model profiles {
  id           String   @id @default(uuid())
  userId       String   @unique
  phoneNumber  String?
  avatarUrl    String?
  bio          String?
  companyName  String?
  location     String?
  portfolioUrl String?
  cityCode     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_documents {
  id        String       @id @default(uuid())
  userId    String
  title     String
  fileUrl   String
  type      DocumentType @default(OTHER)
  createdAt DateTime     @default(now())
  users     users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model portfolios {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  linkUrl     String?
  imageUrl    String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model proposals {
  id                  String               @id @default(uuid())
  jobId               String
  freelancerId        String
  coverLetter         String?
  bidAmount           Decimal              @db.Decimal(15, 2)
  estimatedDays       Int
  status              ProposalStatus       @default(PENDING)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               users                @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  jobs                jobs                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  escrow_transactions escrow_transactions?

  @@unique([jobId, freelancerId])
  @@index([freelancerId])
  @@index([jobId])
}

model resumes_ats {
  id               String   @id @default(uuid())
  userId           String
  fileUrl          String
  atsScore         Int
  feedbackAnalysis Json?
  createdAt        DateTime @default(now())
  users            users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model reviews {
  id                              String   @id @default(uuid())
  jobId                           String   @unique
  reviewerId                      String
  revieweeId                      String
  rating                          Int
  comment                         String?
  createdAt                       DateTime @default(now())
  jobs                            jobs     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  users_reviews_revieweeIdTousers users    @relation("reviews_revieweeIdTousers", fields: [revieweeId], references: [id])
  users_reviews_reviewerIdTousers users    @relation("reviews_reviewerIdTousers", fields: [reviewerId], references: [id])

  @@index([reviewerId])
  @@index([revieweeId])
}

model chat_rooms {
  id                                    String     @id @default(uuid())
  jobId                                 String?
  employerId                            String
  freelancerId                          String
  createdAt                             DateTime   @default(now())
  jobs                                  jobs?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  users_chat_rooms_employerIdTousers   users      @relation("chat_rooms_employerIdTousers", fields: [employerId], references: [id], onDelete: Cascade)
  users_chat_rooms_freelancerIdTousers users      @relation("chat_rooms_freelancerIdTousers", fields: [freelancerId], references: [id], onDelete: Cascade)
  messages                              messages[]

  @@index([employerId])
  @@index([freelancerId])
}

model messages {
  id         String     @id @default(uuid())
  chatRoomId String
  senderId   String
  content    String
  isRead     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  chat_rooms chat_rooms @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  users      users      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatRoomId])
  @@index([senderId])
}

model skills {
  id          String        @id @default(uuid())
  name        String        @unique
  job_skills  job_skills[]
  user_skills user_skills[]
}

model user_skills {
  id      String @id @default(uuid())
  userId  String
  skillId String
  skills  skills @relation(fields: [skillId], references: [id], onDelete: Cascade)
  users   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model users {
  id                                                          String                @id @default(uuid())
  email                                                       String                @unique
  passwordHash                                                String
  fullName                                                    String
  role                                                        Role                  @default(FREELANCER)
  isVerified                                                  Boolean               @default(false)
  createdAt                                                   DateTime              @default(now())
  updatedAt                                                   DateTime              @updatedAt
  escrow_transactions_escrow_transactions_employerIdTousers   escrow_transactions[] @relation("escrow_transactions_employerIdTousers")
  escrow_transactions_escrow_transactions_freelancerIdTousers escrow_transactions[] @relation("escrow_transactions_freelancerIdTousers")
  job_submissions                                             job_submissions[]
  jobs                                                        jobs[]
  notifications                                               notifications[]
  profiles                                                    profiles?
  user_documents                                              user_documents[]
  portfolios                                                  portfolios[]
  proposals                                                   proposals[]
  resumes_ats                                                 resumes_ats[]
  reviews_reviews_revieweeIdTousers                           reviews[]             @relation("reviews_revieweeIdTousers")
  reviews_reviews_reviewerIdTousers                           reviews[]             @relation("reviews_reviewerIdTousers")
  chat_rooms_chat_rooms_employerIdTousers                     chat_rooms[]          @relation("chat_rooms_employerIdTousers")
  chat_rooms_chat_rooms_freelancerIdTousers                   chat_rooms[]          @relation("chat_rooms_freelancerIdTousers")
  messages                                                    messages[]
  user_skills                                                 user_skills[]
}

enum DocumentType {
  CV
  COVER_LETTER
  OTHER
}

enum EscrowStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  FAILED
  EXPIRED
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Role {
  FREELANCER
  UMKM
  ADMIN
}

enum SubmissionStatus {
  PENDING_REVIEW
  REVISION_REQUESTED
  APPROVED
}
